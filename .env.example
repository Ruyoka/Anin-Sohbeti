PORT=6000
NODE_ENV=production
TRUST_PROXY=true
CLIENT_ORIGIN=*

# Rate limits
MESSAGE_RATE_LIMIT_MAX=8
MESSAGE_RATE_LIMIT_WINDOW_MS=5000
JOIN_RATE_LIMIT_MAX=6
JOIN_RATE_LIMIT_WINDOW_MS=15000
CALL_RATE_LIMIT_MAX=12
CALL_RATE_LIMIT_WINDOW_MS=10000

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional R2 upload config
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
CUSTOM_DOMAIN=
R2_REGION=auto
